-- jpeg2000-io.acn
--
-- Bit-level encoding for jpeg2000-io.asn1. Unsigned big-endian throughout
-- (T.800 A.1.3, I.4). The lengths the walker needs (LBox, XLBox, Lxxx of a
-- skipped segment, Psot) are ASN.1 fields. Only the *Segment-Std wrappers
-- insert Lxxx, because their body is decoded with them.

JPEG2000-IO DEFINITIONS ::= BEGIN

BoxHeader [] {
    lbox        [encoding pos-int, size 32, endianness big],
    tbox        [encoding pos-int, size 32, endianness big],
    xlbox       [encoding pos-int, size 64, endianness big, present-when (lbox == 1)]
}

Brand [encoding pos-int, size 32, endianness big]

FtypHeader [] {
    brand       [],
    minor       [encoding pos-int, size 32, endianness big]
}

MarkerCode [encoding pos-int, size 16, endianness big]

SegmentLength [encoding pos-int, size 16, endianness big]

SizSegment-Std [] {
    length      INTEGER [encoding pos-int, size 16, endianness big, mapping-function lxxx],
    body        [size length]
}

CodSegment-Std [] {
    length      INTEGER [encoding pos-int, size 16, endianness big, mapping-function lxxx],
    body        [size length]
}

QcdSegment-Std [] {
    length      INTEGER [encoding pos-int, size 16, endianness big, mapping-function lxxx],
    body        [size length]
}

PltSegment-Std [] {
    length      INTEGER [encoding pos-int, size 16, endianness big, mapping-function lxxx],
    body        [size length]
}

ComSegment-Std [] {
    length      INTEGER [encoding pos-int, size 16, endianness big, mapping-function lxxx],
    body        [size length]
}

DataReferenceCount [encoding pos-int, size 16, endianness big]

UrlHeader [] {
    vers        [encoding pos-int, size 8],
    flag        [encoding pos-int, size 24, endianness big]
}

FragmentCount [encoding pos-int, size 16, endianness big]

-- Rreq of jp2-boxes.acn
Rreq-Std [] {
    ml          INTEGER [encoding pos-int, size 8],
    fuam        [size ml],
    dcm         [size ml],
    nsf         INTEGER [encoding pos-int, size 16, endianness big],
    standard    [size nsf] { <ml> [] },
    nvf         INTEGER [encoding pos-int, size 16, endianness big],
    vendor      [size nvf] { <ml> [] },
    extra       [size deduced]
}

SotSegment [] {
    lsot        [encoding pos-int, size 16, endianness big],
    isot        [encoding pos-int, size 16, endianness big],
    psot        [encoding pos-int, size 32, endianness big],
    tpsot       [encoding pos-int, size 8],
    tnsot       [encoding pos-int, size 8]
}

END
