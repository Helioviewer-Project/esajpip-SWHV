-- jp2-boxes.asn1
--
-- JP2 / JPX file structure (ITU-T T.800 Annex I, T.801 Annex M): the box
-- tree, with the boxes esajpip interprets and the JP2 header boxes (T.800
-- I.5.3) modelled in full, and everything else opaque. Together with j2k-codestream.asn1 this makes a generated
-- vector a complete .jp2 or .jpx file.
--
-- Design (encodings in jp2-boxes.acn):
--   * LBox is an ACN-inserted determinant with mapping function `lbox`
--     (wire = payload bytes + 8). TBox selects the payload through an ACN
--     parameter.
--   * A superbox's children are a `SEQUENCE OF` with `size deduced` inside
--     the CONTAINING region of the superbox — the nested-container case the
--     deduced-size specification was written for.
--   * asn1scc forbids recursive types, so nesting is two levels: TopBox
--     (may be a superbox) contains InnerBox (never a superbox). This covers
--     jp2h/jpch/jplh/ftbl/dtbl and one level of asoc children in the
--     standard model. The server preserves asoc contents without
--     interpreting them. The one third level modelled is the Resolution box
--     (res, in jp2h or jplh), whose children are a type of their own
--     (ResBox). A Colour Group box (cgrp, in jplh) is opaque.
--   * jp2c carries a full Codestream (CONTAINING), so a JP2 vector exercises
--     the codestream framing and the marker bodies in one file.
--
-- Not modelled (documented gaps; the server accepts both):
--   * XLBox (LBox = 1, 64-bit length): the payload would need one of two
--     determinants depending on LBox; never required under the INT_MAX
--     file limit.
--   * LBox = 0 (box extends to end of file): a region cannot be both
--     determinant-sized and deduced.
--   * Codestream Header boxes inside a Compositing Layer Extensions box, and
--     codestreams inside a Multiple Codestream box, are outside the model;
--     every jpch, jp2c and ftbl here is top level, as the server requires.
--   * ICC profiles (colr METH 2) are opaque; so are the reserved fields of
--     colr boxes with other METH values, and the Palette box's entries,
--     whose length is a cross-field rule. The IPR, XML and UUID boxes in
--     jp2h are opaque as elsewhere.
--   * The Reader Requirements box is modelled at layer 1 only; the server
--     ignores it, so layer 2 keeps it opaque.
--
-- Cross-field rules are at the end. The JPX box rules (hv_rule_child,
-- hv_rule_url, hv_rule_flst, hv_rule_fragment_dr, hv_rule_jpx) and the
-- header box rules are ../lib/hv_rules.c, shared by the harness
-- (harness/crossfield_impl.h, harness/crossfield.c) and the reader; the
-- file rules (signature, ftyp, one flst per ftbl, the NDR count) are
-- implemented in both, the harness's and ../lib/hv_reader.c.

JP2-Boxes DEFINITIONS AUTOMATIC TAGS ::= BEGIN

EXPORTS ALL;

IMPORTS Codestream, Codestream-Profile FROM J2K-Codestream;

-- ===========================================================================
-- Layer 1: T.800 Annex I / T.801 Annex M
-- ===========================================================================

-- Box types as the big-endian value of the four-character code.
-- Superboxes and interpreted boxes:
--   jpch 0x6A706368  ftbl 0x6674626C  dtbl 0x6474626C  asoc 0x61736F63
--   jp2c 0x6A703263  flst 0x666C7374  url  0x75726C20  jp2h 0x6A703268
--   jplh 0x6A706C68  ftyp 0x66747970
--   ihdr 0x69686472  bpcc 0x62706363  colr 0x636F6C72  pclr 0x70636C72
--   cmap 0x636D6170  cdef 0x63646566  res  0x72657320  resc 0x72657363
--   resd 0x72657364
-- Opaque, permitted anywhere their level allows:
--   rreq 0x72726571
--   jP   0x6A502020  uuid 0x75756964  xml  0x786D6C20  nlst 0x6E6C7374
--   lbl  0x6C626C20  uinf 0x75696E66  free 0x66726565

-- T.800 I.8 and T.801 M.12 require readers to skip box types they do not
-- understand, so both layers admit every four-cc and decode unlisted types
-- through an opaque `other` alternative.
TopBoxType ::= INTEGER (0..4294967295)
InnerBoxType ::= INTEGER (0..4294967295)

-- A JP2-family file is a sequence of top-level boxes filling the file
-- (the file is the decode region).
Jp2Family ::= SEQUENCE {
    boxes       SEQUENCE (SIZE (1..32)) OF TopBox      -- corpus bound
}

TopBox ::= SEQUENCE {
    payload     TopPayload
}

TopPayload ::= CHOICE {
    jpch        OCTET STRING (CONTAINING Superbox),
    ftbl        OCTET STRING (CONTAINING Superbox),
    dtbl        OCTET STRING (CONTAINING DataReferences),
    asoc        OCTET STRING (CONTAINING Association),
    jp2c        OCTET STRING (CONTAINING Codestream),
    jP          OCTET STRING (CONTAINING OpaqueBox),
    ftyp        OCTET STRING (CONTAINING Ftyp),
    jp2h        OCTET STRING (CONTAINING Superbox),
    jplh        OCTET STRING (CONTAINING Superbox),
    rreq        OCTET STRING (CONTAINING Rreq),
    uuid        OCTET STRING (CONTAINING OpaqueBox),
    xml         OCTET STRING (CONTAINING OpaqueBox),
    uinf        OCTET STRING (CONTAINING Superbox),
    free        OCTET STRING (CONTAINING OpaqueBox),
    other       OCTET STRING (CONTAINING OpaqueBox)
}

-- T.800 I.5.2 / T.801 M.11, File Type box: brand, minor version, then a
-- compatibility list filling the box (so the box is >= 12 bytes and a
-- multiple of 4 by construction). Which brand is required and that the
-- list contains it depend on the file extension: cross-field rules.
Ftyp ::= SEQUENCE {
    brand       OCTET STRING (SIZE (4)),
    minor       INTEGER (0..4294967295),
    compat      SEQUENCE (SIZE (1..16)) OF OCTET STRING (SIZE (4))   -- corpus bound
}

Superbox ::= SEQUENCE {
    children    SEQUENCE (SIZE (0..16)) OF InnerBox    -- fill the superbox (corpus bound)
}

-- T.801 M.11.11: association requires two or more boxes; 16 is a corpus bound.
Association ::= SEQUENCE {
    children    SEQUENCE (SIZE (2..16)) OF InnerBox
}

-- T.801 Annex M, Data Reference box: NDR then NDR url boxes.
DataReferences ::= SEQUENCE {
    ndr         INTEGER (0..65535),
    references  SEQUENCE (SIZE (0..64)) OF InnerBox     -- fill the box; count == ndr, each url (corpus bound)
}

OpaqueBox ::= SEQUENCE {
    data        OCTET STRING (SIZE (0..4096))           -- fills the box (corpus bound)
}

InnerBox ::= SEQUENCE {
    payload     InnerPayload
}

InnerPayload ::= CHOICE {
    flst        OCTET STRING (CONTAINING FragmentList),
    url         OCTET STRING (CONTAINING DataEntryUrl),
    jp2h        OCTET STRING (CONTAINING OpaqueBox),
    jplh        OCTET STRING (CONTAINING OpaqueBox),
    uuid        OCTET STRING (CONTAINING OpaqueBox),
    xml         OCTET STRING (CONTAINING OpaqueBox),
    nlst        OCTET STRING (CONTAINING OpaqueBox),
    lbl         OCTET STRING (CONTAINING OpaqueBox),
    ihdr        OCTET STRING (CONTAINING Ihdr),
    colr        OCTET STRING (CONTAINING Colr),
    free        OCTET STRING (CONTAINING OpaqueBox),
    bpcc        OCTET STRING (CONTAINING Bpcc),
    res         OCTET STRING (CONTAINING Res),
    pclr        OCTET STRING (CONTAINING Pclr),
    cmap        OCTET STRING (CONTAINING Cmap),
    cdef        OCTET STRING (CONTAINING Cdef),
    jp2c        OCTET STRING (CONTAINING OpaqueBox),
    other       OCTET STRING (CONTAINING OpaqueBox)
}

-- ---------------------------------------------------------------------------
-- JP2 header boxes, T.800 I.5.3 (in JPX: T.801 M.11.5 to M.11.7, in jp2h,
-- jpch and jplh). Field values are T.800's; where T.801 admits more (C,
-- METH, EnumCS), the JPX files modelled here carry JPEG 2000 codestreams
-- only, and the other values are rules of the file kind (listed at the end).
-- ---------------------------------------------------------------------------

-- A CONTAINING region's decoder skips to the region's end whatever the
-- contents left unread, so a type whose layout does not end in a deduced
-- size ends in `extra`, the bytes after its fields, which a rule requires
-- to be empty (<box>.extent).
Extra ::= OCTET STRING (SIZE (0..64))                     -- corpus bound

-- Image Header box, I.5.3.1: 14 bytes (the box 22, ihdr.extent).
Ihdr ::= SEQUENCE {
    height      INTEGER (1..4294967295),   -- Ysiz - YOsiz
    width       INTEGER (1..4294967295),   -- Xsiz - XOsiz
    nc          INTEGER (1..16384),        -- Csiz
    bpc         INTEGER (0..37 | 128..165 | 255),   -- common Ssiz, or 255: see bpcc
    c           INTEGER (7),               -- JPEG 2000 (T.801 Table M.19: 7)
    unkc        INTEGER (0..1),
    ipr         INTEGER (0..1),
    extra       Extra
}

-- A component or palette column's bit depth, Tables I.11 and I.13: the
-- depth minus one in the low 7 bits (1 to 38 bits), the sign in the high
-- bit. Ssiz without its reserved values.
BitDepth ::= INTEGER (0..37 | 128..165)

-- Bits Per Component box, I.5.3.2: one BitDepth per component, filling
-- the box; the count is NC.
Bpcc ::= SEQUENCE {
    depths      SEQUENCE (SIZE (1..16)) OF BitDepth     -- corpus bound; the standard's is 16 384
}

-- Colour Specification box, I.5.3.3: METH, PREC, APPROX, then EnumCS when
-- METH is 1; the rest of the box is the ICC profile when METH is 2, fields
-- T.800 reserves for other values, and nothing when METH is 1 (a rule).
-- PREC and APPROX bind writers only (T.800: readers ignore them; T.801
-- M.11.7.2: APPROX 1 to 4 in JPX), as ftyp's MinV, so neither layer
-- constrains them.
ColrHeader ::= SEQUENCE {
    meth        INTEGER (0..255),          -- 1 enumerated, 2 restricted ICC; others: rules
    prec        INTEGER (-128..127),
    approx      INTEGER (0..255),
    enumcs      INTEGER (0..4294967295) OPTIONAL   -- present iff meth = 1
}

Colr ::= SEQUENCE {
    header      ColrHeader,
    rest        OCTET STRING (SIZE (0..4096))    -- fills the box (corpus bound)
}

-- Palette box, I.5.3.4: NE, NPC (the count of depths), a BitDepth per
-- column, then NE x NPC entries, each padded to whole bytes (a rule).
PclrHeader ::= SEQUENCE {
    ne          INTEGER (1..1024),
    depths      SEQUENCE (SIZE (1..255)) OF BitDepth
}

Pclr ::= SEQUENCE {
    header      PclrHeader,
    entries     OCTET STRING (SIZE (0..4096))    -- fills the box (corpus bound)
}

-- Component Mapping box, I.5.3.5: one entry per channel, filling the box.
CmapEntry ::= SEQUENCE {
    cmp         INTEGER (0..16384),        -- component index
    mtyp        INTEGER (0..1),            -- 0 direct, 1 through the palette
    pcol        INTEGER (0..255)           -- palette column; 0 when mtyp = 0 (a rule)
}

Cmap ::= SEQUENCE {
    entries     SEQUENCE (SIZE (1..16)) OF CmapEntry    -- corpus bound
}

-- Channel Definition box, I.5.3.6: N (the count of entries), then N
-- descriptions.
CdefCount ::= INTEGER (1..65535)

CdefEntry ::= SEQUENCE {
    cn          INTEGER (0..65535),        -- channel index
    typ         INTEGER (0..2 | 65535),    -- colour, opacity, premultiplied opacity, unspecified
    asoc        INTEGER (0..65535)         -- 0 whole image, colour index, 65535 none
}

Cdef ::= SEQUENCE {
    entries     SEQUENCE (SIZE (1..16)) OF CdefEntry,   -- corpus bound; the standard's is 65 535
    extra       Extra
}

-- Resolution box, I.5.3.7: a superbox holding resc and/or resd, each once
-- (a rule). Unknown boxes are skipped (I.8).
Res ::= SEQUENCE {
    children    SEQUENCE (SIZE (1..4)) OF ResBox        -- fill the box (corpus bound)
}

ResBoxType ::= INTEGER (0..4294967295)

ResBox ::= SEQUENCE {
    payload     ResPayload
}

ResPayload ::= CHOICE {
    resc        OCTET STRING (CONTAINING Resolution),
    resd        OCTET STRING (CONTAINING Resolution),
    other       OCTET STRING (CONTAINING OpaqueBox)
}

-- Capture and Default Display Resolution boxes, I.5.3.7.1 and I.5.3.7.2:
-- grid points per metre, (VN / VD) * 10^VE and (HN / HD) * 10^HE.
Resolution ::= SEQUENCE {
    vn          INTEGER (1..65535),
    vd          INTEGER (1..65535),
    hn          INTEGER (1..65535),
    hd          INTEGER (1..65535),
    ve          INTEGER (-128..127),
    he          INTEGER (-128..127),
    extra       Extra
}

-- T.801 M.11.1, Reader Requirements box: ML, the length in bytes of every
-- mask (1, 2, 4 or 8; an ACN-inserted determinant, so the masks agree by
-- construction), the Fully Understand Aspects and Display Contents masks,
-- NSF standard features and NVF vendor features, each with its mask. SF
-- values are Table M.14's and those of extensions, so any 16-bit value.
RreqMask ::= OCTET STRING (SIZE (1 | 2 | 4 | 8))

StandardFeature ::= SEQUENCE {
    sf          INTEGER (0..65535),
    sm          RreqMask
}

VendorFeature ::= SEQUENCE {
    vf          OCTET STRING (SIZE (16)),                -- a UUID
    vm          RreqMask
}

Rreq ::= SEQUENCE {
    fuam        RreqMask,
    dcm         RreqMask,
    standard    SEQUENCE (SIZE (0..16)) OF StandardFeature,  -- corpus bound; the standard's is 65 535
    vendor      SEQUENCE (SIZE (0..4)) OF VendorFeature,     -- corpus bound; the standard's is 65 535
    extra       Extra
}

-- T.801 Annex M, Fragment List box: NF fragments of (OFF u64, LEN u32, DR u16).
FragmentList ::= SEQUENCE {
    nf          INTEGER (1..65535),
    fragments   SEQUENCE (SIZE (1..16)) OF Fragment     -- count == nf (corpus bound)
}

Fragment ::= SEQUENCE {
    off         INTEGER (0..18446744073709551615),   -- offset of the fragment in the referenced file
    len         INTEGER (1..4294967295),             -- length of the fragment
    dr          INTEGER (0..65535)                   -- 0: this file; else 1-based index into dtbl
}

-- T.801 Annex M, Data Entry URL box: VERS (1 byte), FLAG (3 bytes), LOC (NUL-terminated).
DataEntryUrl ::= SEQUENCE {
    vers        INTEGER (0..255),
    flag        INTEGER (0..16777215),
    loc         IA5String (SIZE (1..1024))           -- URL, NUL terminated on the wire (corpus bound)
}

-- ===========================================================================
-- Layer 2: esajpip served profile (JPIP_PROFILE.md, "Supported JPEG 2000
-- sources"). Structural rules (counts, pairing) are cross-field rules.
-- Top-level metadata superboxes that the server does not interpret are opaque
-- here; their internal box framing remains part of the standard layer only.
-- ===========================================================================

-- .jp2: exactly one jp2c, carrying a profile codestream. ReadJP2 reads
-- the signature, ftyp and jp2c boxes and skips every other box by length,
-- so every other box is opaque here, superboxes included.
Jp2File-Profile ::= SEQUENCE {
    boxes       SEQUENCE (SIZE (1..32)) OF Jp2Box-Profile
}

Jp2Box-Profile ::= SEQUENCE {
    payload     Jp2Payload-Profile
}

Jp2Payload-Profile ::= CHOICE {
    jp2c        OCTET STRING (CONTAINING Codestream-Profile),
    jP          OCTET STRING (CONTAINING OpaqueBox),
    ftyp        OCTET STRING (CONTAINING Ftyp),
    other       OCTET STRING (CONTAINING OpaqueBox)
}

-- .jpx: N jpch boxes and either N jp2c boxes (embedded) or N ftbl/flst
-- boxes plus one dtbl holding the url boxes (linked), never both. Codestreams
-- are numbered by source-box order (JPIP_PROFILE.md, "Supported JPEG 2000
-- sources").
JpxFile-Profile ::= SEQUENCE {
    boxes       SEQUENCE (SIZE (1..32)) OF TopBox-Profile
}

BoxType-Profile ::= INTEGER (0..4294967295)  -- any four-cc; unlisted ones are `other`

TopBox-Profile ::= SEQUENCE {
    payload     TopPayload-Profile
}

TopPayload-Profile ::= CHOICE {
    jpch        OCTET STRING (CONTAINING Superbox-Profile),
    ftbl        OCTET STRING (CONTAINING Superbox-Profile),
    dtbl        OCTET STRING (CONTAINING DataReferences-Profile),
    asoc        OCTET STRING (CONTAINING OpaqueBox),
    jp2c        OCTET STRING (CONTAINING Codestream-Profile),
    jP          OCTET STRING (CONTAINING OpaqueBox),
    ftyp        OCTET STRING (CONTAINING Ftyp),
    jp2h        OCTET STRING (CONTAINING OpaqueBox),
    jplh        OCTET STRING (CONTAINING OpaqueBox),
    rreq        OCTET STRING (CONTAINING OpaqueBox),
    uuid        OCTET STRING (CONTAINING OpaqueBox),
    xml         OCTET STRING (CONTAINING OpaqueBox),
    uinf        OCTET STRING (CONTAINING OpaqueBox),
    free        OCTET STRING (CONTAINING OpaqueBox),
    other       OCTET STRING (CONTAINING OpaqueBox)
}

Superbox-Profile ::= SEQUENCE {
    children    SEQUENCE (SIZE (0..16)) OF InnerBox-Profile
}

DataReferences-Profile ::= SEQUENCE {
    ndr         INTEGER (0..65535),
    references  SEQUENCE (SIZE (0..64)) OF InnerBox-Profile
}

InnerBox-Profile ::= SEQUENCE {
    payload     InnerPayload-Profile
}

InnerPayload-Profile ::= CHOICE {
    flst        OCTET STRING (CONTAINING FragmentList-Profile),
    url         OCTET STRING (CONTAINING DataEntryUrl-Profile),
    jp2h        OCTET STRING (CONTAINING OpaqueBox),
    jplh        OCTET STRING (CONTAINING OpaqueBox),
    uuid        OCTET STRING (CONTAINING OpaqueBox),
    xml         OCTET STRING (CONTAINING OpaqueBox),
    nlst        OCTET STRING (CONTAINING OpaqueBox),
    lbl         OCTET STRING (CONTAINING OpaqueBox),
    ihdr        OCTET STRING (CONTAINING OpaqueBox),
    colr        OCTET STRING (CONTAINING OpaqueBox),
    free        OCTET STRING (CONTAINING OpaqueBox),
    bpcc        OCTET STRING (CONTAINING OpaqueBox),
    res         OCTET STRING (CONTAINING OpaqueBox),
    pclr        OCTET STRING (CONTAINING OpaqueBox),
    cmap        OCTET STRING (CONTAINING OpaqueBox),
    cdef        OCTET STRING (CONTAINING OpaqueBox),
    jp2c        OCTET STRING (CONTAINING OpaqueBox),
    other       OCTET STRING (CONTAINING OpaqueBox)
}

-- One fragment describing the complete codestream in the referenced file
-- (ReadFlstBox: box length 16, NF == 1).
FragmentList-Profile ::= FragmentList (WITH COMPONENTS {
    nf (1..1),
    fragments (SIZE (1..1))
})

-- Version-zero file:// URLs (ReadUrlBox).
DataEntryUrl-Profile ::= DataEntryUrl (WITH COMPONENTS {
    vers (0..0),
    flag (0..0),
    loc (SIZE (8..1024))                             -- "file://" plus at least one character
})

END

-- ===========================================================================
-- Cross-field constraints for the box layer (../lib/hv_rules.c and, for
-- the file rules, harness/crossfield_impl.h, harness/crossfield.c and
-- ../lib/hv_reader.c; see the top)
-- ===========================================================================
--
-- Standard (both layers of a .jpx; for a .jp2, layer 1 and, at layer 2,
-- only the signature and ftyp rules, as Jp2Payload-Profile keeps every
-- other box opaque):
--   T.800 I.4: the first box is jP with payload 0D0A870A, the second is ftyp.
--   T.800 I.5.2 / T.801 M.8: the ftyp brand is 'jp2 ' for a .jp2 and
--     'jpx ' for a .jpx, and the compatibility list contains that brand. The
--     standard states this per format -- a conforming JP2 file carries 'jp2 '
--     in a CLi field, a conforming JPX file carries 'jpx ' -- which for the
--     two permitted brands is the same rule (ReadFileType). Box size and
--     alignment are the Ftyp type's job. MinV (0 for JP2, 1 for JPX) binds
--     writers only: readers shall parse the file whatever its value and
--     esajpip ignores it, so neither layer constrains it.
--   T.801 M.11.2 (JPX): at most one dtbl box, at the top level.
--   T.801 M.11.1: a JPX file has exactly one rreq box immediately after
--     ftyp. The profile parser deliberately ignores this writer requirement.
--     Its contents are Rreq (ML the length of every mask, NSF and NVF the
--     counts: determinants, so they agree by construction), with nothing
--     after them (rreq.extent). That the masks describe the file's
--     features accurately is the writer's to ensure (M.11.1); SF values
--     are open (Table M.14 and extensions).
--   T.801 M.11.6: if any jpch box is present, the number of codestreams
--     (jp2c and ftbl boxes) equals the number of codestream headers; each is
--     numbered by source-box order. A file with no jpch box inherits its
--     header information from jp2h and is unconstrained here.
--   DataReferences.references has exactly ndr elements and every one is url.
--   jp2c, jpch, ftbl and dtbl only at the top level; flst only in an ftbl,
--     url only in a dtbl (M.11.2, M.11.3, M.11.6; ReadJPX).
--   FragmentList.fragments has exactly nf elements.
--   DataEntryUrl.loc contains no NUL (the wire terminator is not part of loc).
--   Every Fragment.dr is 0 or <= the file's ndr.
--   T.801 Annex M, Fragment Table box: it contains exactly one flst box.
--   Every CONTAINING region is exactly filled. Where the type ends in a
--     deduced size this is automatic; the url box's harness check requires
--     it to end right after the terminator; Ihdr, Cdef, Resolution and Rreq
--     end in `extra`, which must be empty (<box>.extent: the decoder skips
--     to the end of a region whatever its contents left unread).
--
-- Header boxes, standard layer only (hv_rules.c; the reader's
-- hv_check_jp2h and hv_check_jpx_headers). The server reads none of them:
-- Jp2Payload-Profile and TopPayload-Profile keep jp2h and jplh opaque, and
-- jpch's children are InnerBox-Profile, whose header boxes are opaque.
--   JP2 file (T.800 I.2, I.5.3, I.5.4): one or more jp2c
--     (jp2.codestream); exactly one jp2h (jp2.one-jp2h), before the first
--     jp2c (jp2h.position).
--   JPX file (T.801 M.11.5): jp2h optional, before the first jp2c, ftbl,
--     jpch or jplh (jp2h.position).
--   jp2h starts with ihdr (jp2h.ihdr-first) and holds its colr boxes
--     contiguously (jp2h.colr-contiguous). A header box holds at most one
--     bpcc, pclr, cmap, cdef and res (header.one-<box>); a jpch at most one
--     ihdr (header.one-ihdr; elsewhere a second ihdr is ignored, I.5.3.1).
--   colr: nothing after EnumCS when METH is 1 (colr.enumcs-length). JP2:
--     METH 1 or 2 (colr.method), and EnumCS 16, 17 or 18 in the first colr
--     (colr.enumcs). JPX: no two enumerated and no two ICC colr in jp2h
--     (colr.one-method, M.11.7.1).
--   pclr: NE x NPC entries, each of its column's depth padded to whole
--     bytes (pclr.entries-length).
--   cmap: PCOL 0 when MTYP is 0 (cmap.pcol-zero).
--   cdef: no two descriptions with the same Typ and Asoc, except where
--     either is 65535 (cdef.pairs).
--   res: resc, resd or both, each at most once (res.resc-resd).
--   The header of each codestream: in a JP2 file jp2h; in a JPX file
--     codestream k's jpch over jp2h's defaults (M.11.6), or jp2h alone when
--     there is no jpch.
--     JP2: at least one colr (jp2h.colr); bpcc exactly when BPC is 255
--       (ihdr.bpcc); pclr exactly with cmap (header.pclr-cmap).
--     JPX: an ihdr in jpch or jp2h (jpch.ihdr); bpcc when BPC is 255
--       (ihdr.bpcc); pclr needs cmap and an MTYP 1 entry needs pclr
--       (header.pclr-cmap).
--     Both: bpcc has NC entries (bpcc.count); cmap components below NC
--       (cmap.component) and palette columns below NPC
--       (cmap.palette-column); JP2: cdef channels below the channel count,
--       cmap's or NC (cdef.channel).
--     Against the codestream's SIZ (T.800 I.5.3.1, I.5.3.2), where the
--       codestream is in the file: HEIGHT = Ysiz - YOsiz (ihdr.height),
--       WIDTH = Xsiz - XOsiz (ihdr.width), NC = Csiz (ihdr.nc), BPC the
--       components' common Ssiz or 255 when they differ (ihdr.bpc), each
--       bpcc entry the component's Ssiz (bpcc.depth).
--   Not checked: that cdef is absent when the channels are the colours in
--     order and that it describes every colour (I.5.3.6); a colour group
--     in JPX (M.11.7.1: cgrp is opaque), opct against cdef, and the header
--     of a linked codestream against the linked file's SIZ.
--
-- Profile only (ReadJP2 / ReadJPX):
--   Jp2File-Profile: exactly one jp2c among the top-level boxes.
--   JpxFile-Profile: at least one jpch box, where the standard lets a JPX
--     file fall back on jp2h. jp2c boxes and ftbl boxes do not both occur
--     (no mixed sources); the standard allows a file to hold some codestreams
--     inline and others by reference. Linked: exactly one top-level dtbl and
--     every flst's dr in 1..ndr.
--     (ReadJPX; the order of jp2c relative to jpch is not constrained.)
--   These JPX rules apply to .jpx files only; ReadJP2 looks at nothing but
--     jp2c boxes.
--   Every url loc begins with "file://" and ends with ".jp2" (ReadJPX: links
--     resolve to .jp2 files only, never to another JPX); the harness does not
--     resolve it.
--   Fragment (off, len) equal to the referenced file's codestream extent is
--     checked by the server against the linked file and is outside the
--     corpus (it needs the second file).
--   The whole file is <= INT_MAX bytes.
