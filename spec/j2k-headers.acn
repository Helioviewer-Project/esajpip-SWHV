-- j2k-headers.acn
--
-- Bit-level encoding for j2k-headers.asn1: marker segment bodies, starting
-- at the byte after Lxxx. One encoding serves both layers; asn1scc does
-- not inherit it through the *-Profile types, so they restate it (below).
--
-- Conventions (T.800 A.1.3): unsigned big-endian integers; BOOLEAN is one
-- bit, '1'B = TRUE; where the standard packs sub-fields into one byte the
-- SEQUENCE lists them MSB first.
--
-- Every body is decoded inside a CONTAINING region sized by its Lxxx (see
-- j2k-codestream.acn). Lists with no count on the wire therefore use
-- `size deduced` (Docs/deduced-size-spec.md): they fill the region, and an
-- element overrunning it or a leftover byte is a decode error. Rules
-- satisfied: elements are byte-granular and >= 8 bits, the deduced list is
-- the last component of its region, one deduced list per region.
--
-- Scod.customPrecincts does not size Spcod.precincts: the list is `size
-- deduced`, and the cross-field rule cod.precincts-count ties its length to
-- the flag (end of j2k-headers.asn1).
--
-- Boolean presence uses the bare-field form of present-when
-- (`[present-when b0.more]`), which the 4.9.3.0 grammar lists as the first
-- presentWhenCond alternative; dotted paths are `longFld` and grammatical.

J2K-Headers DEFINITIONS ::= BEGIN

Siz [] {
    fixed       [],
    components  [size deduced]
}

SizFixed [] {
    rsiz        [encoding pos-int, size 16, endianness big],
    xsiz        [encoding pos-int, size 32, endianness big],
    ysiz        [encoding pos-int, size 32, endianness big],
    xosiz       [encoding pos-int, size 32, endianness big],
    yosiz       [encoding pos-int, size 32, endianness big],
    xtsiz       [encoding pos-int, size 32, endianness big],
    ytsiz       [encoding pos-int, size 32, endianness big],
    xtosiz      [encoding pos-int, size 32, endianness big],
    ytosiz      [encoding pos-int, size 32, endianness big],
    csiz        [encoding pos-int, size 16, endianness big]
}

Component [] {
    isSigned    [true-value '1'B],                -- Ssiz bit 7
    depthMinus1 [encoding pos-int, size 7],       -- Ssiz bits 6..0
    xrsiz       [encoding pos-int, size 8],
    yrsiz       [encoding pos-int, size 8]
}

Cod [] {
    scod        [],
    sgcod       [],
    spcod       []
}

Scod [] {
    reserved        [encoding pos-int, size 5],   -- bits 7..3
    ephMarkers      [true-value '1'B],            -- bit 2
    sopMarkers      [true-value '1'B],            -- bit 1
    customPrecincts [true-value '1'B]             -- bit 0
}

Sgcod [] {
    progression     [encoding pos-int, size 8],
    layers          [encoding pos-int, size 16, endianness big],
    mct             [encoding pos-int, size 8]
}

Spcod [] {
    levels          [encoding pos-int, size 8],
    cbWidthExp      [encoding pos-int, size 8],
    cbHeightExp     [encoding pos-int, size 8],
    cbStyle         [encoding pos-int, size 8],
    transform       [encoding pos-int, size 8],
    precincts       [size deduced]                 -- empty or r = 0 .. NL
}

PrecinctSize [] {
    ppy         [encoding pos-int, size 4],       -- bits 7..4
    ppx         [encoding pos-int, size 4]        -- bits 3..0
}

-- Parameterized bodies: the encoding is stated on the template and repeated
-- on every instance (asn1scc generates each instance separately).
QcdBody [] {
    sqcd        [encoding pos-int, size 8],
    spqcd       [size deduced]
}

Qcd [] {
    sqcd        [encoding pos-int, size 8],
    spqcd       [size deduced]
}

Qcd-Std [] {
    sqcd        [encoding pos-int, size 8],
    spqcd       [size deduced]
}

PltBody [] {
    zplt        [],
    entries     [size deduced]
}

Plt [] {
    zplt        [],
    entries     [size deduced]
}

Zplt [encoding pos-int, size 8]

Rcom [encoding pos-int, size 16, endianness big]

Iplt [] {
    b0  [],
    b1  [present-when b0.more],
    b2  [present-when b1.more],
    b3  [present-when b2.more],
    b4  [present-when b3.more],
    b5  [present-when b4.more],
    b6  [present-when b5.more],
    b7  [present-when b6.more],
    b8  [present-when b7.more],
    b9  [present-when b8.more]
}

IpltByte [] {
    more    BOOLEAN [true-value '1'B],            -- derived from following OPTIONAL
    bits    [encoding pos-int, size 7]            -- bits 6..0
}

IpltByteLast [] {
    end     NULL [pattern '0'B],                  -- tenth byte must terminate
    bits    [encoding pos-int, size 7]
}

ComBody [] {
    rcom        [],
    ccom        [size deduced]
}

Com [] {
    rcom        [],
    ccom        [size deduced]
}

-- ASN.1 WITH COMPONENTS subtypes have distinct generated ACN functions.
-- State their wire encodings explicitly; they are byte-for-byte identical to
-- the base marker-body types above and differ only in ASN.1 constraints.
Siz-Profile [] {
    fixed       [],
    components  [size deduced]
}

SizFixed-Profile [] {
    rsiz        [encoding pos-int, size 16, endianness big],
    xsiz        [encoding pos-int, size 32, endianness big],
    ysiz        [encoding pos-int, size 32, endianness big],
    xosiz       [encoding pos-int, size 32, endianness big],
    yosiz       [encoding pos-int, size 32, endianness big],
    xtsiz       [encoding pos-int, size 32, endianness big],
    ytsiz       [encoding pos-int, size 32, endianness big],
    xtosiz      [encoding pos-int, size 32, endianness big],
    ytosiz      [encoding pos-int, size 32, endianness big],
    csiz        [encoding pos-int, size 16, endianness big]
}

Component-Profile [] {
    isSigned    [true-value '1'B],
    depthMinus1 [encoding pos-int, size 7],
    xrsiz       [encoding pos-int, size 8],
    yrsiz       [encoding pos-int, size 8]
}

Cod-Profile [] {
    scod        [],
    sgcod       [],
    spcod       []
}

Qcd-Profile [] {
    sqcd        [encoding pos-int, size 8],
    spqcd       [size deduced]
}

Plt-Profile [] {
    zplt        [],
    entries     [size deduced]
}

Com-Profile [] {
    rcom        [],
    ccom        [size deduced]
}

END
