@@ -0,0 +1,5 @@
+TEST-CASE DEFINITIONS ::= BEGIN
+    Bounded [] { len INTEGER [encoding pos-int, size 8], data [size len] }
+    ZeroMin [] { len INTEGER [encoding pos-int, size 8], data [size len] }
+    Fixed [] { len INTEGER [encoding pos-int, size 8], data [size len] }
+END
diff --git a/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/025.asn1 b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/025.asn1
