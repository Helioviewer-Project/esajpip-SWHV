diff --git a/v4Tests/scripts/runDeferredAcnRegressions.sh b/v4Tests/scripts/runDeferredAcnRegressions.sh
new file mode 100644
index 00000000..2c8d2218
--- /dev/null
+++ b/v4Tests/scripts/runDeferredAcnRegressions.sh
@@ -0,0 +1,34 @@
+#!/bin/sh
+
+set -eu
+
+root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
+cases=$root/v4Tests/test-cases/acn-v2
+compiler=${ASN1SCC:-$root/asn1scc/bin/Debug/net10.0/asn1scc.dll}
+temporary=$(mktemp -d "${TMPDIR:-/tmp}/asn1scc-acn-v2.XXXXXX")
+
+cleanup() {
+    rm -rf "$temporary"
+}
+trap cleanup EXIT HUP INT TERM
+
+run_compiler() {
+    case $compiler in
+        *.dll) dotnet "$compiler" "$@" ;;
+        *) "$compiler" "$@" ;;
+    esac
+}
+
+for number in 001; do
+    output=$temporary/$number
+    mkdir "$output"
+    run_compiler -c -ACN --acn-v2 -atc --field-prefix AUTO \
+        -o "$output" "$cases/$number.asn1" "$cases/$number.acn"
+    (
+        cd "$output"
+        cc -std=c11 -pedantic-errors -Wall -Wextra -Werror ./*.c -o tests
+        ./tests
+    )
+done
+
+echo "Deferred ACN regressions passed"
diff --git a/v4Tests/test-cases/acn-v2/001.acn b/v4Tests/test-cases/acn-v2/001.acn
new file mode 100644
index 00000000..fb0ca542
--- /dev/null
+++ b/v4Tests/test-cases/acn-v2/001.acn
@@ -0,0 +1,18 @@
+TEST-CASE DEFINITIONS ::= BEGIN
+
+Chain [] {
+    first [],
+    second [present-when first.more]
+}
+
+Byte [] {
+    more BOOLEAN [true-value '1'B],
+    bits [encoding pos-int, size 7]
+}
+
+Last [] {
+    end NULL [pattern '0'B],
+    bits [encoding pos-int, size 7]
+}
+
+END
diff --git a/v4Tests/test-cases/acn-v2/001.asn1 b/v4Tests/test-cases/acn-v2/001.asn1
new file mode 100644
index 00000000..0feb3e59
--- /dev/null
+++ b/v4Tests/test-cases/acn-v2/001.asn1
@@ -0,0 +1,19 @@
+-- A Boolean determinant produced by a referenced child controls the presence
+-- of its sibling. The determinant must cross the reference boundary and use
+-- the one-bit deferred runtime representation.
+TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
+
+Chain ::= SEQUENCE {
+    first   Byte,
+    second  Last OPTIONAL
+}
+
+Byte ::= SEQUENCE {
+    bits INTEGER (0..127)
+}
+
+Last ::= SEQUENCE {
+    bits INTEGER (0..127)
+}
+
+END
