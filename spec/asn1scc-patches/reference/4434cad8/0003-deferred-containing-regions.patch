index 00000000..3c2d1388
--- /dev/null
+++ b/v4Tests/test-cases/acn-v2/004.asn1
@@ -0,0 +1,18 @@
+-- A mapped length determinant sizes a parameterized CHOICE. Encoding must
+-- measure the selected alternative, apply the mapping, and patch the field.
+TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
+
+Document ::= SEQUENCE {
+    payload Payload
+}
+
+Payload ::= CHOICE {
+    value OCTET STRING (CONTAINING Value),
+    other OCTET STRING (CONTAINING Value)
+}
+
+Value ::= SEQUENCE {
+    number INTEGER (0..255)
+}
+
+END
diff --git a/v4Tests/test-cases/acn-v2/004_mapping.c b/v4Tests/test-cases/acn-v2/004_mapping.c
new file mode 100644
