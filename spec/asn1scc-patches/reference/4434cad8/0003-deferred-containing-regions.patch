diff --git a/v4Tests/test-cases/acn-v2/003.acn b/v4Tests/test-cases/acn-v2/003.acn
new file mode 100644
index 00000000..ac24db44
--- /dev/null
+++ b/v4Tests/test-cases/acn-v2/003.acn
@@ -0,0 +1,37 @@
+TEST-CASE DEFINITIONS ::= BEGIN
+
+Document [] {
+    boxes [size deduced]
+}
+
+OuterBox [] {
+    length INTEGER [encoding pos-int, size 8],
+    kind INTEGER [encoding pos-int, size 8],
+    payload <kind, length> []
+}
+
+OuterPayload <INTEGER:kind, INTEGER:length> [] {
+    nested [present-when kind == 1, size length],
+    value [present-when kind == 4, size length]
+}
+
+Nested [] {
+    boxes [size deduced]
+}
+
+InnerBox [] {
+    length INTEGER [encoding pos-int, size 8],
+    kind INTEGER [encoding pos-int, size 8],
+    payload <kind, length> []
+}
+
+InnerPayload <INTEGER:kind, INTEGER:length> [] {
+    value [present-when kind == 2, size length],
+    other [present-when kind == 3, size length]
+}
+
+Value [] {
+    number [encoding pos-int, size 8]
+}
+
+END
diff --git a/v4Tests/test-cases/acn-v2/003.asn1 b/v4Tests/test-cases/acn-v2/003.asn1
new file mode 100644
index 00000000..9f752cb1
--- /dev/null
+++ b/v4Tests/test-cases/acn-v2/003.asn1
@@ -0,0 +1,35 @@
+-- Length determinants cross nested SEQUENCE, CHOICE, and referenced-type
+-- boundaries in both producer and consumer directions.
+TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
+
+Document ::= SEQUENCE {
+    boxes SEQUENCE (SIZE (1..4)) OF OuterBox
+}
+
+OuterBox ::= SEQUENCE {
+    payload OuterPayload
+}
+
+OuterPayload ::= CHOICE {
+    nested OCTET STRING (CONTAINING Nested),
+    value OCTET STRING (CONTAINING Value)
+}
+
+Nested ::= SEQUENCE {
+    boxes SEQUENCE (SIZE (1..4)) OF InnerBox
+}
+
+InnerBox ::= SEQUENCE {
+    payload InnerPayload
+}
+
+InnerPayload ::= CHOICE {
+    value OCTET STRING (CONTAINING Value),
+    other OCTET STRING (CONTAINING Value)
+}
+
+Value ::= SEQUENCE {
+    number INTEGER (0..255)
+}
+
+END
