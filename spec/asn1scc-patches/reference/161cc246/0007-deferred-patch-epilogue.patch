+acn_deferred_det_optional_producer_check(sParent, sAcc, sProducer, sConsumer, sErrCode) ::= <<
+if !<sParent><sAcc>exist.<sProducer><if(sConsumer)> && <sParent><sAcc>exist.<sConsumer><endif> {
+    *pErrCode = <sErrCode>;
+    return false;
+}
+>>
+
+acn_deferred_det_optional_producer_wrap(sParent, sAcc, sProducer, sBody) ::= <<
+if <sParent><sAcc>exist.<sProducer> {
+    <sBody>
+}
+>>
+
 /* AcnInsertedFieldRef type name */
 acn_deferred_det_type_name() ::= "acn::AcnInsertedFieldRef"
 
