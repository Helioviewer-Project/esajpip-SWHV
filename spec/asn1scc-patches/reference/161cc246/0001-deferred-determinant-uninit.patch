-/* Assignment after temp-variable decode: det.value = (asn1SccUint)tmp; */
+/* Assignment after temp-variable decode: det.value = (asn1SccUint)tmp;
+   Only when the decode succeeded: a failed decode may return without
+   writing tmp (BitStream_ReadBit does at end of stream), leaving it
+   uninitialized. */
 acn_deferred_det_copy_tmp_encode(sDetAccess, sTmpName) ::= ""
-acn_deferred_det_copy_tmp_decode(sDetAccess, sTmpName) ::= "<sDetAccess> = (asn1SccUint)<sTmpName>;"
+acn_deferred_det_copy_tmp_decode(sDetAccess, sTmpName) ::= <<
+if (ret) {
+    <sDetAccess> = (asn1SccUint)<sTmpName>;
+}
+>>
 
 /* Boolean tmp variant — C cast works as for int.  Kept as a distinct macro so
    strongly-typed backends (Ada) can emit a different conversion. */
 acn_deferred_det_copy_bool_tmp_encode(sDetAccess, sTmpName) ::= ""
-acn_deferred_det_copy_bool_tmp_decode(sDetAccess, sTmpName) ::= "<sDetAccess> = (asn1SccUint)<sTmpName>;"
+acn_deferred_det_copy_bool_tmp_decode(sDetAccess, sTmpName) ::= <<
+if (ret) {
+    <sDetAccess> = (asn1SccUint)<sTmpName>;
+}
+>>
 
 /* Enum tmp variant — same C output as int (enum→uint is implicit).  The
    sEnumTypeName parameter is unused in C; Ada needs it for 'Enum_Rep. */
 acn_deferred_det_copy_enum_tmp_encode(sDetAccess, sTmpName, sEnumTypeName) ::= ""
-acn_deferred_det_copy_enum_tmp_decode(sDetAccess, sTmpName, sEnumTypeName) ::= "<sDetAccess> = (asn1SccUint)<sTmpName>;"
+acn_deferred_det_copy_enum_tmp_decode(sDetAccess, sTmpName, sEnumTypeName) ::= <<
+if (ret) {
+    <sDetAccess> = (asn1SccUint)<sTmpName>;
+}
+>>
 
