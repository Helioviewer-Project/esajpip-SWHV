diff --git a/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/020.asn1 b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/020.asn1
new file mode 100644
index 0000000..864a368
--- /dev/null
+++ b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/020.asn1
@@ -0,0 +1,11 @@
+-- ACNV2_ONLY C_ONLY NO_AUTOMATIC_TEST_CASES
+-- A CONTAINING reference to a constrained subtype must validate the subtype.
+TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
+
+X ::= SEQUENCE { field INTEGER (0..1) }
+X-P ::= X (WITH COMPONENTS { field (0..0) })
+W ::= SEQUENCE { body OCTET STRING (CONTAINING X-P) }
+
+END
+
+--TCFS   020.acn
diff --git a/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/020_wire_test.c b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/020_wire_test.c
new file mode 100644
index 0000000..b115d63
--- /dev/null
+++ b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/020_wire_test.c
@@ -0,0 +1,28 @@
+#include <assert.h>
+
+#include "020.h"
+
+int main(void)
+{
+    byte invalid_wire[] = {1, 1};
+    byte valid_wire[] = {1, 0};
+    BitStream stream;
+    W value;
+    int error = 0;
+
+    W_Initialize(&value);
+    value.body.field = 1;
+    assert(!W_IsConstraintValid(&value, &error));
+
+    W_Initialize(&value);
+    BitStream_AttachBuffer(&stream, invalid_wire, sizeof invalid_wire);
+    error = 0;
+    assert(!W_ACN_Decode(&value, &stream, &error));
+
+    W_Initialize(&value);
+    BitStream_AttachBuffer(&stream, valid_wire, sizeof valid_wire);
+    error = 0;
+    assert(W_ACN_Decode(&value, &stream, &error));
+
+    return 0;
+}
