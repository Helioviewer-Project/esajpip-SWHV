diff --git a/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/019.asn1 b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/019.asn1
new file mode 100644
index 0000000..24b597e
--- /dev/null
+++ b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/019.asn1
@@ -0,0 +1,19 @@
+-- ACNV2_ONLY C_ONLY
+-- A fixed-size OCTET STRING has no nCount member in generated C. A deferred
+-- determinant shared by the direct child and the reference child must use
+-- the declared size for both patches. scripts/runWireTests.sh checks the
+-- exact encoding and decoding (019_wire_test.c).
+TEST-CASE DEFINITIONS AUTOMATIC TAGS ::= BEGIN
+
+Item ::= SEQUENCE {
+    data OCTET STRING (SIZE (2))
+}
+
+Msg ::= SEQUENCE {
+    head OCTET STRING (SIZE (2)),
+    payload Item
+}
+
+END
+
+--TCFS   019.acn
diff --git a/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/019_wire_test.c b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/019_wire_test.c
new file mode 100644
index 0000000..a993a86
--- /dev/null
+++ b/v4Tests/test-cases/acn/25-ACNV2-BOUNDARIES/019_wire_test.c
@@ -0,0 +1,32 @@
+/* Byte-exact check of 019 (run by v4Tests/scripts/runWireTests.sh):
+   the fixed-size head and payload data have no nCount member. */
+#include <assert.h>
+#include <string.h>
+
+#include "019.h"
+
+int main(void)
+{
+    static const byte expected[] = {2, 0xAA, 0xAA, 0xBB, 0xBB};
+    byte encoded[Msg_REQUIRED_BYTES_FOR_ACN_ENCODING] = {0};
+    BitStream stream;
+    Msg input;
+    Msg output;
+    long length;
+    int error = 0;
+
+    Msg_Initialize(&input);
+    memset(input.head.arr, 0xAA, sizeof input.head.arr);
+    memset(input.payload.data.arr, 0xBB, sizeof input.payload.data.arr);
+    BitStream_Init(&stream, encoded, sizeof encoded);
+    assert(Msg_ACN_Encode(&input, &stream, &error, TRUE));
+    length = BitStream_GetLength(&stream);
+    assert(length == sizeof expected && memcmp(encoded, expected, sizeof expected) == 0);
+
+    Msg_Initialize(&output);
+    BitStream_AttachBuffer(&stream, encoded, length);
+    assert(Msg_ACN_Decode(&output, &stream, &error));
+    assert(Msg_Equal(&input, &output));
+
+    return 0;
+}
