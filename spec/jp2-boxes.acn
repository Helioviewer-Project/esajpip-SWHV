-- jp2-boxes.acn
--
-- Bit-level encoding for jp2-boxes.asn1 (T.800 Annex I box syntax).
-- Unsigned big-endian throughout.
--
-- Inserted determinants and mapping functions (harness/mapping.c):
--   lbox : wire = payload bytes + 8   (LBox counts LBox and TBox)
--   boxtype : keep the TBox values listed in TopPayload, InnerPayload and
--             their -Profile versions; decode all others as 'abcd' so the
--             opaque `other` branch handles every unknown type
--   resboxtype : the same inside a Resolution box, keeping resc and resd
--             (ResPayload)
--   jp2boxtype : the same for a .jp2 at the profile layer, keeping only jP,
--             ftyp and jp2c (Jp2Payload-Profile)
-- spec/check-model.sh checks each list against the CHOICEs it serves, and
-- that every `other` alternative is 'abcd' (MAPPING_OTHER_BOX).
-- The payload of every box is a CONTAINING region sized by LBox; superbox
-- children and opaque data use `size deduced` inside it. The whole file is
-- the top-level region for Jp2Family.boxes.
--
-- The url LOC string is NUL-terminated on the wire (termination-pattern
-- '00'H); the terminator is not part of the ASN.1 value, and any bytes
-- after it are `extra`.

JP2-Boxes DEFINITIONS ::= BEGIN

-- ---------------------------------------------------------------------------
-- Layer 1
-- ---------------------------------------------------------------------------

Jp2Family [] {
    boxes       [size deduced]                    -- fills the file
}

TopBox [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    topType     BoxType [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <topType, lbox> []
}

TopPayload <BoxType:tbox, INTEGER:length> [] {
    jpch        [present-when tbox == 1785750376, size length],
    ftbl        [present-when tbox == 1718903404, size length],
    dtbl        [present-when tbox == 1685348972, size length],
    asoc        [present-when tbox == 1634955107, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    jP          [present-when tbox == 1783636000, size length],
    ftyp        [present-when tbox == 1718909296, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    rreq        [present-when tbox == 1920099697, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    uinf        [present-when tbox == 1969843814, size length],
    free        [present-when tbox == 1718773093, size length],
    other       [present-when tbox == 1633837924, size length]
}

Association [] {
    children    [size deduced]
}

Superbox [] {
    children    [size deduced]
}

DataReferences [] {
    ndr         [encoding pos-int, size 16, endianness big],
    references  [size deduced]
}

OpaqueBox [] {
    data        [size deduced]
}

Brand [encoding pos-int, size 32, endianness big]

Ftyp [] {
    brand       [],
    minor       [encoding pos-int, size 32, endianness big],
    compat      [size deduced]
}

InnerBox [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    innerType   BoxType [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <innerType, lbox> []
}

InnerPayload <BoxType:tbox, INTEGER:length> [] {
    flst        [present-when tbox == 1718383476, size length],
    url         [present-when tbox == 1970433056, size length],
    jpch        [present-when tbox == 1785750376, size length],
    ftbl        [present-when tbox == 1718903404, size length],
    dtbl        [present-when tbox == 1685348972, size length],
    asoc        [present-when tbox == 1634955107, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    nlst        [present-when tbox == 1852601204, size length],
    lbl         [present-when tbox == 1818389536, size length],
    ihdr        [present-when tbox == 1768449138, size length],
    colr        [present-when tbox == 1668246642, size length],
    free        [present-when tbox == 1718773093, size length],
    bpcc        [present-when tbox == 1651532643, size length],
    res         [present-when tbox == 1919251232, size length],
    pclr        [present-when tbox == 1885564018, size length],
    cmap        [present-when tbox == 1668112752, size length],
    cdef        [present-when tbox == 1667523942, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    other       [present-when tbox == 1633837924, size length]
}

-- JP2 header boxes, T.800 I.5.3

Ihdr [] {
    height      [encoding pos-int, size 32, endianness big],
    width       [encoding pos-int, size 32, endianness big],
    nc          [encoding pos-int, size 16, endianness big],
    bpc         [encoding pos-int, size 8],
    c           [encoding pos-int, size 8],
    unkc        [encoding pos-int, size 8],
    ipr         [encoding pos-int, size 8],
    extra       [size deduced]
}

BitDepth [encoding pos-int, size 8]

Bpcc [] {
    depths      [size deduced]
}

ColrHeader [] {
    meth        [encoding pos-int, size 8],
    prec        [encoding twos-complement, size 8],
    approx      [encoding pos-int, size 8],
    enumcs      [present-when (meth == 1), encoding pos-int, size 32, endianness big]
}

Colr [] {
    header      [],
    rest        [size deduced]
}

PclrHeader [] {
    ne          [encoding pos-int, size 16, endianness big],
    npc         INTEGER [encoding pos-int, size 8],
    depths      [size npc]
}

Pclr [] {
    header      [],
    entries     [size deduced]
}

CmapEntry [] {
    cmp         [encoding pos-int, size 16, endianness big],
    mtyp        [encoding pos-int, size 8],
    pcol        [encoding pos-int, size 8]
}

Cmap [] {
    entries     [size deduced]
}

CdefCount [encoding pos-int, size 16, endianness big]

CdefEntry [] {
    cn          [encoding pos-int, size 16, endianness big],
    typ         [encoding pos-int, size 16, endianness big],
    asoc        [encoding pos-int, size 16, endianness big]
}

Cdef [] {
    n           CdefCount [],
    entries     [size n],
    extra       [size deduced]
}

Res [] {
    children    [size deduced]
}

ResBox [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    resType     BoxType [encoding pos-int, size 32, endianness big, mapping-function resboxtype],
    payload     <resType, lbox> []
}

ResPayload <BoxType:tbox, INTEGER:length> [] {
    resc        [present-when tbox == 1919251299, size length],
    resd        [present-when tbox == 1919251300, size length],
    other       [present-when tbox == 1633837924, size length]
}

Resolution [] {
    vn          [encoding pos-int, size 16, endianness big],
    vd          [encoding pos-int, size 16, endianness big],
    hn          [encoding pos-int, size 16, endianness big],
    hd          [encoding pos-int, size 16, endianness big],
    ve          [encoding twos-complement, size 8],
    he          [encoding twos-complement, size 8],
    extra       [size deduced]
}

-- Reader Requirements box, T.801 M.11.1. ML, NSF and NVF are inserted
-- determinants; ML reaches the masks of the features through the element
-- types' parameter (spec/asn1scc-patches: deferred-sequence-of-arguments
-- and deferred-sibling-consumers).

StandardFeature <INTEGER:ml> [] {
    sf          [encoding pos-int, size 16, endianness big],
    sm          [size ml]
}

VendorFeature <INTEGER:ml> [] {
    vf          [],
    vm          [size ml]
}

Rreq [] {
    ml          INTEGER [encoding pos-int, size 8],
    fuam        [size ml],
    dcm         [size ml],
    nsf         INTEGER [encoding pos-int, size 16, endianness big],
    standard    [size nsf] { <ml> [] },
    nvf         INTEGER [encoding pos-int, size 16, endianness big],
    vendor      [size nvf] { <ml> [] },
    extra       [size deduced]
}

FragmentList [] {
    nf          [encoding pos-int, size 16, endianness big],
    fragments   [size deduced]
}

Fragment [] {
    off         [encoding pos-int, size 64, endianness big],
    len         [encoding pos-int, size 32, endianness big],
    dr          [encoding pos-int, size 16, endianness big]
}

DataEntryUrl [] {
    vers        [encoding pos-int, size 8],
    flag        [encoding pos-int, size 24, endianness big],
    loc         [encoding ASCII, size null-terminated, termination-pattern '00'H],
    extra       [size deduced]                    -- after the NUL: empty in a valid box
}

-- ---------------------------------------------------------------------------
-- Layer 2: identical layout, profile payloads
-- ---------------------------------------------------------------------------

Jp2File-Profile [] {
    boxes       [size deduced]
}

Jp2Box-Profile [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    jp2Type     BoxType [encoding pos-int, size 32, endianness big, mapping-function jp2boxtype],
    payload     <jp2Type, lbox> []
}

-- jp2boxtype maps every type but jp2c, jP and ftyp to `other`.
Jp2Payload-Profile <BoxType:tbox, INTEGER:length> [] {
    jp2c        [present-when tbox == 1785737827, size length],
    jP          [present-when tbox == 1783636000, size length],
    ftyp        [present-when tbox == 1718909296, size length],
    other       [present-when tbox == 1633837924, size length]
}

JpxFile-Profile [] {
    boxes       [size deduced]
}

TopBox-Profile [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    profileTopType BoxType [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <profileTopType, lbox> []
}

TopPayload-Profile <BoxType:tbox, INTEGER:length> [] {
    jpch        [present-when tbox == 1785750376, size length],
    ftbl        [present-when tbox == 1718903404, size length],
    dtbl        [present-when tbox == 1685348972, size length],
    asoc        [present-when tbox == 1634955107, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    jP          [present-when tbox == 1783636000, size length],
    ftyp        [present-when tbox == 1718909296, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    rreq        [present-when tbox == 1920099697, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    uinf        [present-when tbox == 1969843814, size length],
    free        [present-when tbox == 1718773093, size length],
    other       [present-when tbox == 1633837924, size length]
}

Superbox-Profile [] {
    children    [size deduced]
}

DataReferences-Profile [] {
    ndr         [encoding pos-int, size 16, endianness big],
    references  [size deduced]
}

FragmentList-Profile [] {
    nf          [encoding pos-int, size 16, endianness big],
    fragments   []                  -- fixed SIZE (1..1): asn1scc refuses `size deduced`
}

DataEntryUrl-Profile [] {
    vers        [encoding pos-int, size 8],
    flag        [encoding pos-int, size 24, endianness big],
    loc         [encoding ASCII, size null-terminated, termination-pattern '00'H],
    extra       [size deduced]
}

InnerBox-Profile [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    profileInnerType BoxType [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <profileInnerType, lbox> []
}

InnerPayload-Profile <BoxType:tbox, INTEGER:length> [] {
    flst        [present-when tbox == 1718383476, size length],
    url         [present-when tbox == 1970433056, size length],
    jpch        [present-when tbox == 1785750376, size length],
    ftbl        [present-when tbox == 1718903404, size length],
    dtbl        [present-when tbox == 1685348972, size length],
    asoc        [present-when tbox == 1634955107, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    nlst        [present-when tbox == 1852601204, size length],
    lbl         [present-when tbox == 1818389536, size length],
    ihdr        [present-when tbox == 1768449138, size length],
    colr        [present-when tbox == 1668246642, size length],
    free        [present-when tbox == 1718773093, size length],
    bpcc        [present-when tbox == 1651532643, size length],
    res         [present-when tbox == 1919251232, size length],
    pclr        [present-when tbox == 1885564018, size length],
    cmap        [present-when tbox == 1668112752, size length],
    cdef        [present-when tbox == 1667523942, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    other       [present-when tbox == 1633837924, size length]
}

END
