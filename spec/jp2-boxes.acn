-- jp2-boxes.acn
--
-- Bit-level encoding for jp2-boxes.asn1 (T.800 Annex I box syntax).
-- Unsigned big-endian throughout.
--
-- Inserted determinants and mapping functions (harness/mapping.c):
--   lbox : wire = payload bytes + 8   (LBox counts LBox and TBox)
--   boxtype : keep listed TBox values; decode all others as 'abcd' so
--             the opaque `other` branch handles every unknown type
-- The payload of every box is a CONTAINING region sized by LBox; superbox
-- children and opaque data use `size deduced` inside it. The whole file is
-- the top-level region for Jp2Family.boxes.
--
-- The url LOC string is NUL-terminated on the wire (termination-pattern
-- '00'H); the terminator is not part of the ASN.1 value.

JP2-Boxes DEFINITIONS ::= BEGIN

-- ---------------------------------------------------------------------------
-- Layer 1
-- ---------------------------------------------------------------------------

Jp2Family [] {
    boxes       [size deduced]                    -- fills the file
}

TopBox [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    topType     TopBoxType [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <topType, lbox> []
}

TopPayload <TopBoxType:tbox, INTEGER:length> [] {
    jpch        [present-when tbox == 1785750376, size length],
    ftbl        [present-when tbox == 1718903404, size length],
    dtbl        [present-when tbox == 1685348972, size length],
    asoc        [present-when tbox == 1634955107, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    jP          [present-when tbox == 1783636000, size length],
    ftyp        [present-when tbox == 1718909296, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    rreq        [present-when tbox == 1920099697, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    uinf        [present-when tbox == 1969843814, size length],
    free        [present-when tbox == 1718773093, size length],
    other       [present-when tbox == 1633837924, size length]
}

Association [] {
    children    [size deduced]
}

Superbox [] {
    children    [size deduced]
}

DataReferences [] {
    ndr         [encoding pos-int, size 16, endianness big],
    references  [size deduced]
}

OpaqueBox [] {
    data        [size deduced]
}

Ftyp [] {
    brand       [],
    minor       [encoding pos-int, size 32, endianness big],
    compat      [size deduced]
}

InnerBox [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    innerType   InnerBoxType [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <innerType, lbox> []
}

InnerPayload <InnerBoxType:tbox, INTEGER:length> [] {
    flst        [present-when tbox == 1718383476, size length],
    url         [present-when tbox == 1970433056, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    nlst        [present-when tbox == 1852601204, size length],
    lbl         [present-when tbox == 1818389536, size length],
    ihdr        [present-when tbox == 1768449138, size length],
    colr        [present-when tbox == 1668246642, size length],
    free        [present-when tbox == 1718773093, size length],
    bpcc        [present-when tbox == 1651532643, size length],
    res         [present-when tbox == 1919251232, size length],
    pclr        [present-when tbox == 1885564018, size length],
    cmap        [present-when tbox == 1668112752, size length],
    cdef        [present-when tbox == 1667523942, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    other       [present-when tbox == 1633837924, size length]
}

FragmentList [] {
    nf          [encoding pos-int, size 16, endianness big],
    fragments   [size deduced]
}

Fragment [] {
    off         [encoding pos-int, size 64, endianness big],
    len         [encoding pos-int, size 32, endianness big],
    dr          [encoding pos-int, size 16, endianness big]
}

DataEntryUrl [] {
    vers        [encoding pos-int, size 8],
    flag        [encoding pos-int, size 24, endianness big],
    loc         [encoding ASCII, size null-terminated, termination-pattern '00'H]
}

-- ---------------------------------------------------------------------------
-- Layer 2: identical layout, profile payloads
-- ---------------------------------------------------------------------------

Jp2File-Profile [] {
    boxes       [size deduced]
}

Jp2Box-Profile [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    jp2Type     BoxType-Profile [encoding pos-int, size 32, endianness big, mapping-function jp2boxtype],
    payload     <jp2Type, lbox> []
}

-- jp2boxtype maps every type but jp2c, jP and ftyp to `other`.
Jp2Payload-Profile <BoxType-Profile:tbox, INTEGER:length> [] {
    jp2c        [present-when tbox == 1785737827, size length],
    jP          [present-when tbox == 1783636000, size length],
    ftyp        [present-when tbox == 1718909296, size length],
    other       [present-when tbox == 1633837924, size length]
}

JpxFile-Profile [] {
    boxes       [size deduced]
}

TopBox-Profile [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    profileTopType BoxType-Profile [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <profileTopType, lbox> []
}

TopPayload-Profile <BoxType-Profile:tbox, INTEGER:length> [] {
    jpch        [present-when tbox == 1785750376, size length],
    ftbl        [present-when tbox == 1718903404, size length],
    dtbl        [present-when tbox == 1685348972, size length],
    asoc        [present-when tbox == 1634955107, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    jP          [present-when tbox == 1783636000, size length],
    ftyp        [present-when tbox == 1718909296, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    rreq        [present-when tbox == 1920099697, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    uinf        [present-when tbox == 1969843814, size length],
    free        [present-when tbox == 1718773093, size length],
    other       [present-when tbox == 1633837924, size length]
}

Superbox-Profile [] {
    children    [size deduced]
}

DataReferences-Profile [] {
    ndr         [encoding pos-int, size 16, endianness big],
    references  [size deduced]
}

FragmentList-Profile [] {
    nf          [encoding pos-int, size 16, endianness big],
    fragments   []
}

DataEntryUrl-Profile [] {
    vers        [encoding pos-int, size 8],
    flag        [encoding pos-int, size 24, endianness big],
    loc         [encoding ASCII, size null-terminated, termination-pattern '00'H]
}

InnerBox-Profile [] {
    lbox        INTEGER [encoding pos-int, size 32, endianness big, mapping-function lbox],
    profileInnerType BoxType-Profile [encoding pos-int, size 32, endianness big, mapping-function boxtype],
    payload     <profileInnerType, lbox> []
}

InnerPayload-Profile <BoxType-Profile:tbox, INTEGER:length> [] {
    flst        [present-when tbox == 1718383476, size length],
    url         [present-when tbox == 1970433056, size length],
    jp2h        [present-when tbox == 1785737832, size length],
    jplh        [present-when tbox == 1785752680, size length],
    uuid        [present-when tbox == 1970628964, size length],
    xml         [present-when tbox == 2020437024, size length],
    nlst        [present-when tbox == 1852601204, size length],
    lbl         [present-when tbox == 1818389536, size length],
    ihdr        [present-when tbox == 1768449138, size length],
    colr        [present-when tbox == 1668246642, size length],
    free        [present-when tbox == 1718773093, size length],
    bpcc        [present-when tbox == 1651532643, size length],
    res         [present-when tbox == 1919251232, size length],
    pclr        [present-when tbox == 1885564018, size length],
    cmap        [present-when tbox == 1668112752, size length],
    cdef        [present-when tbox == 1667523942, size length],
    jp2c        [present-when tbox == 1785737827, size length],
    other       [present-when tbox == 1633837924, size length]
}

END
