-- jp2-boxes.acn
--
-- Bit-level encoding for jp2-boxes.asn1 (T.800 Annex I box syntax).
-- Unsigned big-endian throughout.
--
-- Inserted determinant and mapping function (harness/mapping.c):
--   lbox : wire = payload bytes + 8   (LBox counts LBox and TBox)
-- The payload of every box is a CONTAINING region sized by LBox; superbox
-- children and opaque data use `size deduced` inside it. The whole file is
-- the top-level region for Jp2Family.boxes.
--
-- The url LOC string is NUL-terminated on the wire (termination-pattern
-- '00'H); the terminator is not part of the ASN.1 value.

JP2-Boxes DEFINITIONS ::= BEGIN

-- ---------------------------------------------------------------------------
-- Layer 1
-- ---------------------------------------------------------------------------

Jp2Family [] {
    boxes       [size deduced]                    -- fills the file
}

TopBox [] {
    lbox        [encoding pos-int, size 32, endianness big, mapping-function lbox],
    tbox        [encoding pos-int, size 32, endianness big],
    payload     <tbox> [size lbox]
}

TopPayload <INTEGER:tbox> [] {
    jpch        [present-when tbox == 1785750376],
    ftbl        [present-when tbox == 1718903404],
    dtbl        [present-when tbox == 1685348972],
    asoc        [present-when tbox == 1634955107],
    jp2c        [present-when tbox == 1785737827],
    jP          [present-when tbox == 1783636000],
    ftyp        [present-when tbox == 1718909296],
    jp2h        [present-when tbox == 1785737832],
    jplh        [present-when tbox == 1785752680],
    rreq        [present-when tbox == 1920099697],
    uuid        [present-when tbox == 1970628964],
    xml         [present-when tbox == 2020437024],
    uinf        [present-when tbox == 1969843814],
    free        [present-when tbox == 1718773093]
}

Superbox [] {
    children    [size deduced]
}

DataReferences [] {
    ndr         [encoding pos-int, size 16, endianness big],
    references  [size deduced]
}

OpaqueBox [] {
    data        [size deduced]
}

InnerBox [] {
    lbox        [encoding pos-int, size 32, endianness big, mapping-function lbox],
    tbox        [encoding pos-int, size 32, endianness big],
    payload     <tbox> [size lbox]
}

InnerPayload <INTEGER:tbox> [] {
    flst        [present-when tbox == 1718383476],
    url         [present-when tbox == 1970433056],
    jp2h        [present-when tbox == 1785737832],
    jplh        [present-when tbox == 1785752680],
    uuid        [present-when tbox == 1970628964],
    xml         [present-when tbox == 2020437024],
    nlst        [present-when tbox == 1852601204],
    lbl         [present-when tbox == 1818389536],
    ihdr        [present-when tbox == 1768449138],
    colr        [present-when tbox == 1668246642],
    free        [present-when tbox == 1718773093],
    bpcc        [present-when tbox == 1651532643],
    res         [present-when tbox == 1919251232],
    pclr        [present-when tbox == 1885564018],
    cmap        [present-when tbox == 1668112752],
    cdef        [present-when tbox == 1667523942]
}

FragmentList [] {
    nf          [encoding pos-int, size 16, endianness big],
    fragments   [size nf]
}

Fragment [] {
    off         [encoding pos-int, size 64, endianness big],
    len         [encoding pos-int, size 32, endianness big],
    dr          [encoding pos-int, size 16, endianness big]
}

DataEntryUrl [] {
    vers        [encoding pos-int, size 8],
    flag        [encoding pos-int, size 24, endianness big],
    loc         [size null-terminated, termination-pattern '00'H]
}

-- ---------------------------------------------------------------------------
-- Layer 2: identical layout, profile payloads
-- ---------------------------------------------------------------------------

Jp2File-Profile [] {
    boxes       [size deduced]
}

JpxFile-Profile [] {
    boxes       [size deduced]
}

TopBox-Profile [] {
    lbox        [encoding pos-int, size 32, endianness big, mapping-function lbox],
    tbox        [encoding pos-int, size 32, endianness big],
    payload     <tbox> [size lbox]
}

TopPayload-Profile <INTEGER:tbox> [] {
    jpch        [present-when tbox == 1785750376],
    ftbl        [present-when tbox == 1718903404],
    dtbl        [present-when tbox == 1685348972],
    asoc        [present-when tbox == 1634955107],
    jp2c        [present-when tbox == 1785737827],
    jP          [present-when tbox == 1783636000],
    ftyp        [present-when tbox == 1718909296],
    jp2h        [present-when tbox == 1785737832],
    jplh        [present-when tbox == 1785752680],
    rreq        [present-when tbox == 1920099697],
    uuid        [present-when tbox == 1970628964],
    xml         [present-when tbox == 2020437024],
    uinf        [present-when tbox == 1969843814],
    free        [present-when tbox == 1718773093],
    other       [present-when not (tbox == 1785750376 or tbox == 1718903404 or tbox == 1685348972 or tbox == 1634955107 or tbox == 1785737827 or tbox == 1783636000 or tbox == 1718909296 or tbox == 1785737832 or tbox == 1785752680 or tbox == 1920099697 or tbox == 1970628964 or tbox == 2020437024 or tbox == 1969843814 or tbox == 1718773093)]
}

Superbox-Profile [] {
    children    [size deduced]
}

DataReferences-Profile [] {
    ndr         [encoding pos-int, size 16, endianness big],
    references  [size deduced]
}

InnerBox-Profile [] {
    lbox        [encoding pos-int, size 32, endianness big, mapping-function lbox],
    tbox        [encoding pos-int, size 32, endianness big],
    payload     <tbox> [size lbox]
}

InnerPayload-Profile <INTEGER:tbox> [] {
    flst        [present-when tbox == 1718383476],
    url         [present-when tbox == 1970433056],
    jp2h        [present-when tbox == 1785737832],
    jplh        [present-when tbox == 1785752680],
    uuid        [present-when tbox == 1970628964],
    xml         [present-when tbox == 2020437024],
    nlst        [present-when tbox == 1852601204],
    lbl         [present-when tbox == 1818389536],
    ihdr        [present-when tbox == 1768449138],
    colr        [present-when tbox == 1668246642],
    free        [present-when tbox == 1718773093],
    bpcc        [present-when tbox == 1651532643],
    res         [present-when tbox == 1919251232],
    pclr        [present-when tbox == 1885564018],
    cmap        [present-when tbox == 1668112752],
    cdef        [present-when tbox == 1667523942],
    other       [present-when not (tbox == 1718383476 or tbox == 1970433056 or tbox == 1785737832 or tbox == 1785752680 or tbox == 1970628964 or tbox == 2020437024 or tbox == 1852601204 or tbox == 1818389536 or tbox == 1768449138 or tbox == 1668246642 or tbox == 1718773093 or tbox == 1651532643 or tbox == 1919251232 or tbox == 1885564018 or tbox == 1668112752 or tbox == 1667523942)]
}

END
